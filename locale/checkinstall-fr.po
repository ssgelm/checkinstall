"--nodoc                        Ne pas inclure les fichiers de documentation"

#: checkinstall.in:166
msgid "*Info display options*"
msgstr "*Options d'affichage des informations*"

#: checkinstall.in:168
msgid "-d<0|1|2>                      Set debug level"
msgstr "-d<0|1|2>                      Définir le niveau de débogage"

